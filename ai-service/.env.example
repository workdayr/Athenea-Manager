# Copia este archivo a ai-service/.env y completa los valores.
# El .env NO se versiona.

# Misma cadena que backend/.env (Neon o el postgres de docker-compose).
DATABASE_URL=

# Ollama corre nativo en el host.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Modelos locales (sin fallback en la nube).
AI_CHAT_MODEL=qwen3:8b
AI_EMBEDDING_MODEL=qwen3-embedding:0.6b
AI_EMBEDDING_DIM=1024

# Recuperación y generación.
AI_TOP_K=4
AI_MIN_SIMILARITY=0.35
AI_MAX_TOKENS=400
AI_CONTEXT_LENGTH=8192
AI_TEMPERATURE=0.1
AI_REQUEST_TIMEOUT_S=90

# Ingesta.
AI_CHUNK_SIZE=1000
AI_CHUNK_OVERLAP=150
AI_EMBED_BATCH_SIZE=16

# Carpeta del host donde están los PDFs subidos (bind mount de Docker).
AI_UPLOAD_DIR=D:/Athenea/uploads
# Cada cuántos segundos se indexan PDFs nuevos. 0 desactiva el sync.
AI_SYNC_INTERVAL_S=120

# Servicio.
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8010
# Generar con: openssl rand -hex 32
AI_SERVICE_TOKEN=
AI_RATE_LIMIT_PER_MINUTE=12

LOG_LEVEL=INFO
