.angular/

# Ionic build output
/www
.ionic/

# Cordova (ignorar solo si usas plugins/plataformas de Cordova en lugar de Capacitor)
/plugins
/platforms

# ==========================================
# PHP & COMPOSER (BACKEND)
# ==========================================
# Dependencias de Composer
/vendor
composer.phar

# Bases de datos locales (si se usan durante desarrollo)
*.sqlite
*.sqlite3
*.db

# Logs de errores de PHP
php_errors.log

# ==========================================
# DEPENDENCIAS FRONTEND & NODE
# ==========================================
/node_modules
/dist
/build

# Prisma Client generado (se regenera con `prisma generate`)
/src/generated

# Info incremental de TypeScript
*.tsbuildinfo

# ==========================================
# LOGS & RUNTIME
# ==========================================
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pids
*.pid
*.seed
*.pid.lock
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ==========================================
# TESTS
# ==========================================
/coverage
/.nyc_output

# ==========================================
