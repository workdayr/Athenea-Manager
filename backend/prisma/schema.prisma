generator client {
  provider        = "prisma-client"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
  // Dentro de src/ para que `nest build` (tsc, rootDir src) compile el
  // cliente generado dentro de dist/ y resuelva en runtime.
  output          = "../src/generated/prisma"
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// Modelo para RAG con soporte vectorial y control de acceso
model Document {
  id         String   @id @default(uuid())
  title      String
  content    String
  embedding  Unsupported("vector(1536)")? // Embeddings estándar (OpenAI/OpenRouter)
  roleAccess String[] @default([])        // Roles con acceso (ej. ['ADMIN', 'MANAGER'])
  createdAt  DateTime                     @default(now())
  updatedAt  DateTime                     @updatedAt
}

// Tablas de autenticacion (BetterAuth). La tabla "user" es la fuente de
// verdad de usuarios; la tabla legacy "Users" del diccionario de datos
// se elimino (migracion drop_users_legacy).

model User {
  id             String    @id
  name           String
  email          String
  emailVerified  Boolean   @default(false)
  image          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  // RF-001: rol de plataforma. Por defecto STUDENT; el administrador lo
  // reasigna despues. El cliente nunca puede fijarlo (input: false).
  role           Role      @default(STUDENT)
  // RF-010: contador de intentos fallidos y expiracion del bloqueo.
  // Internos: no se exponen en respuestas (returned: false).
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  sessions       Session[]
  accounts       Account[]
  projectUsers   Project_User[]
  // RF-019 / RF-017: vinculos de auditoria y evaluacion
  // (Audit_Log.actor_id, Proposal_Evaluation.reviewer_id y
  // Review_Conflict.reviewer_id/resolved_by apuntan a user.id).
  auditLogs         Audit_Log[]
  evaluations       Proposal_Evaluation[] @relation("EvaluationReviewer")
  conflictReviews   Review_Conflict[]     @relation("ConflictReviewer")
  resolvedConflicts Review_Conflict[]     @relation("ConflictResolver")
  // NUEVO: Relación con las tareas asignadas (US 5.2)
  assignedMilestones Milestone[]
  // RF-014: notificaciones in-app y correos encolados del usuario.
  notifications      Notification[]
  // F1-02 / F1-11: historial de estados, certificacion de anonimizacion y
  // revision documental (BR-003/BR-012).
  statusTransitions         Project_Status_Transition[] @relation("StatusTransitionActor")
  anonymizationCertifications Project[]                @relation("AnonymizationCertifier")
  documentReviews           ProjectDocument[]           @relation("DocumentReviewer")

  @@unique([email])
  @@map("user")
}

/**
 * Roles de plataforma (diccionario de datos, seccion 4.1 del documento
 * de arquitectura). Los roles de proyecto (PI/Co-Investigador/Asistente)
 * se modelaran en Project_User en una tarea posterior.
 */
enum Role {
  STUDENT
  PRINCIPAL_INVESTIGATOR
  COORDINATOR
  COMMITTEE
  ADMINISTRATOR
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  // Identificador del emisor de la cuenta (requerido por BetterAuth 1.7:
  // "local:credential" para email+password). Sin esta columna el registro
  // falla con 500 al crear la fila `account`.
  issuer                String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum ProjectStatus {
  Draft
  Proposed
  Under_Review
  Approved
  Active
  Completed
  Closed
  Rejected
  Suspended
}

enum ProjectRole {
  Principal_Investigator
  Co_Investigator
  Assistant
}

enum DocType {
  hypothesis
  abstract
  methodology
  rationale
  results
  ethics_approval
  evidence
}

enum Visibility {
  Team_only
  Shared_with_administration
}

/**
 * BR-003 / F1-11: estado de revision de un documento del expediente.
 * El informe final (`results`) debe estar `Approved` para completar el
 * proyecto; la aprobacion de etica (`ethics_approval`) debe estar
 * `Approved` para aprobar proyectos con humanos/animales/datos sensibles.
 */
enum DocumentReviewStatus {
  Pending
  Approved
  Rejected
}

// NUEVO: Enum para el estado de las tareas (US 5.2)
enum MilestoneStatus {
  Pending
  Completed
  Delayed
}

enum ProductType {
  journal_article
  conference_presentation
  software
  patent
  thesis
}

// ==========================================
// MODELOS (Tablas de la base de datos)
// ==========================================

model Announcement {
  call_id         Int       @id @default(autoincrement())
  title           String    @db.VarChar(200)
  date_published  DateTime? @db.Timestamp()
  deadline        DateTime  @db.Timestamp()
  description     String    @db.Text
  application_cap Int
  // US 2.2 / RF-018: estado de la convocatoria y contador de
  // postulaciones (el contador + SELECT ... FOR UPDATE serializan el cupo).
  status            CallStatus @default(DRAFT)
  application_count Int        @default(0)

  projects        Project[]
}

/**
 * US 2.2 / RF-018: ciclo de vida de una convocatoria.
 * DRAFT = creada por el admin, aun no visible. OPEN = recibe
 * postulaciones. CLOSED = cerrada por deadline, cupo o manualmente.
 */
enum CallStatus {
  DRAFT
  OPEN
  CLOSED
}

model Project {
  project_id      Int           @id @default(autoincrement())
  title           String        @db.VarChar(300)
  objectives      String        @db.Text
  start_date      DateTime      @db.Timestamp()
  end_date        DateTime      @db.Timestamp()
  status          ProjectStatus @default(Proposed)
  budget_enabled  Boolean       @default(false)
  is_confidential Boolean
  // Convocatoria de origen (US 2.1: registro en respuesta a una call).
  // Opcional para no bloquear registros fuera de convocatoria.
  call_id         Int?

  // F1-11 / BR-006: banderas de investigacion sensible declaradas en el
  // alta. Las de investigacion solo pueden corregirse antes de Approved.
  research_involves_humans  Boolean @default(false)
  research_involves_animals Boolean @default(false)
  uses_sensitive_data       Boolean @default(false)

  // F1-11 / BR-012: certificacion de anonimizacion a nivel de proyecto.
  anonymization_certified    Boolean   @default(false)
  anonymization_certified_at DateTime? @db.Timestamp()
  anonymization_certified_by String?

  // F1-11 / BR-013: retencion de proyectos con seres humanos.
  retention_delete_at   DateTime? @db.Timestamp()
  retention_notified_at DateTime? @db.Timestamp()
  retention_deleted_at  DateTime? @db.Timestamp()

  // F1-02: fecha del ultimo cambio de estado y marca de aviso SLA.
  status_changed_at DateTime  @default(now()) @db.Timestamp()
  sla_notified_at   DateTime? @db.Timestamp()

  // RF-020: archivo institucional inmutable. El proyecto conserva su
  // informacion, pero ninguna operacion de escritura puede modificarla.
  is_read_only    Boolean       @default(false)
  archived_at     DateTime?     @db.Timestamp()

  // Relaciones inversas
  call            Announcement?   @relation(fields: [call_id], references: [call_id])
  projectUsers    Project_User[]
  documents       ProjectDocument[] 
  milestones      Milestone[]
  products        Product[]
  expenses        Expense[]
  // RF-019: historial formal de decisiones y alertas de conflicto (BR-011).
  evaluations     Proposal_Evaluation[]
  conflicts       Review_Conflict[]
  // RF-020: snapshot inmutable y alertas de archivado fallido.
  archive         Project_Archive?
  archiveAlerts   Archive_Alert[]
  // F1-02: historial de transiciones de estado.
  statusTransitions Project_Status_Transition[]
  // F1-11: usuario que certifico la anonimizacion.
  anonymizationCertifier User? @relation("AnonymizationCertifier", fields: [anonymization_certified_by], references: [id], onDelete: SetNull, onUpdate: Cascade)

  // RF-008 / RF-013: indices para el dashboard institucional.
  @@index([status])
  @@index([status, is_read_only])
  @@index([start_date, end_date])
  @@index([call_id])
  // F1-02 / F1-11: jobs de SLA y retencion.
  @@index([status, status_changed_at])
  @@index([status, sla_notified_at])
  @@index([retention_delete_at])
  @@index([status, retention_delete_at])
}

model Project_User {
  projectuser_id  Int         @id @default(autoincrement())
  project_id      Int
  // PI / miembro del equipo (FK a user.id de BetterAuth, texto).
  user_id         String
  project_role    ProjectRole

  // Llaves foráneas
  project         Project     @relation(fields: [project_id], references: [project_id])
  user            User        @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // RF-008: consultas de PI y de investigadores activos por proyecto.
  @@index([project_id, project_role])
  @@index([user_id])
}

model ProjectDocument {
  document_id     Int         @id @default(autoincrement())
  project_id      Int
  // NUEVO: Para saber a qué tarea pertenece la evidencia
  milestone_id    Int?
  doc_type        DocType
  visibility      Visibility
  file_url        String
  version         Int
  file_name       String?
  file_size       Int?
  uploaded_at     DateTime    @default(now()) @db.Timestamp()

  // F1-11 / BR-003: revision administrativa del documento. Solo `results`
  // (informe final) y `ethics_approval` son revisables.
  review_status DocumentReviewStatus @default(Pending)
  reviewed_at   DateTime?            @db.Timestamp()
  reviewed_by   String?
  review_notes  String?              @db.Text

  project         Project     @relation(fields: [project_id], references: [project_id])
  // NUEVO: Relación inversa
  milestone       Milestone?  @relation(fields: [milestone_id], references: [milestone_id])
  reviewer        User?       @relation("DocumentReviewer", fields: [reviewed_by], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([project_id])
  @@index([milestone_id])
  @@index([project_id, doc_type, review_status])
}

/**
 * F1-02 / RF-003: bitacora inmutable de cambios de estado del proyecto.
 * Cada transicion guarda actor, estados y justificacion opcional.
 */
model Project_Status_Transition {
  transition_id Int           @id @default(autoincrement())
  project_id    Int
  actor_id      String
  from_status   ProjectStatus
  to_status     ProjectStatus
  justification String?       @db.Text
  created_at    DateTime      @default(now()) @db.Timestamp()

  project       Project       @relation(fields: [project_id], references: [project_id], onDelete: Cascade, onUpdate: Cascade)
  actor         User          @relation("StatusTransitionActor", fields: [actor_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([project_id, created_at])
  @@index([actor_id])
}

model Milestone {
  milestone_id    Int             @id @default(autoincrement())
  project_id      Int
  name            String          @db.VarChar(150)
  // CAMBIO: String en lugar de Int
  assignee_id     String
  due_date        DateTime        @db.Date
  status          MilestoneStatus @default(Pending)

  project         Project         @relation(fields: [project_id], references: [project_id])
  // NUEVO: Relación con el usuario de BetterAuth
  assignee        User            @relation(fields: [assignee_id], references: [id], onDelete: Cascade)
  // NUEVO: Relación con la evidencia
  documents       ProjectDocument[]

  // RF-006 / RF-008: hitos por proyecto y deteccion de retrasos.
  @@index([project_id, status, due_date])
  @@index([assignee_id])
}

model Product {
  product_id      Int         @id @default(autoincrement())
  project_id      Int
  product_type    ProductType
  url_doi         String

  // Llaves foráneas
  project         Project     @relation(fields: [project_id], references: [project_id])

  // RF-008: productividad cientifica por proyecto.
  @@index([project_id])
}

model Expense {
  expense_id          Int       @id @default(autoincrement())
  project_id          Int
  amount              Decimal   @db.Decimal(9, 2)
  expense_description String    @db.VarChar(255)
  // RF-008: permite filtrar el presupuesto ejercido por el rango del
  // dashboard. Los registros existentes se backfillean con la fecha de
  // inicio del proyecto en la migracion.
  expense_date        DateTime  @default(now()) @db.Date

  // Llaves foráneas
  project             Project   @relation(fields: [project_id], references: [project_id])

  @@index([project_id, expense_date])
}

model Audit_Log {
  log_id          Int       @id @default(autoincrement())
  // Actor de la accion auditada (RF-017): FK a user.id de BetterAuth.
  actor_id        String
  action          String    @db.VarChar(255)
  target_id       String    @db.VarChar(255)
  source_ip       String
  timestamp       DateTime  @default(now()) @db.Timestamp()

  // Llaves foráneas
  actor           User      @relation(fields: [actor_id], references: [id])
}

// ==========================================
// EVALUACION DE PROPUESTAS (RF-019, BR-011)
// Decisiones formales del comite y alertas de
// conflicto de interes familiar persistentes.
// ==========================================

enum EvaluationDecision {
  Approved
  Rejected
  Revision_Required
}

enum ConflictStatus {
  Pending
  Cleared
  Confirmed
}

model Proposal_Evaluation {
  evaluation_id Int                @id @default(autoincrement())
  project_id    Int
  reviewer_id   String
  decision      EvaluationDecision
  justification String             @db.Text
  created_at    DateTime           @default(now()) @db.Timestamp()

  // Llaves foráneas
  project       Project            @relation(fields: [project_id], references: [project_id], onDelete: Restrict, onUpdate: Cascade)
  reviewer      User               @relation("EvaluationReviewer", fields: [reviewer_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([project_id])
  @@index([reviewer_id])
  @@index([created_at])
}

model Review_Conflict {
  conflict_id     Int            @id @default(autoincrement())
  project_id      Int
  reviewer_id     String
  status          ConflictStatus @default(Pending)
  detected_at     DateTime       @default(now()) @db.Timestamp()
  resolved_at     DateTime?      @db.Timestamp()
  resolved_by     String?
  resolution_note String?        @db.Text

  // Llaves foráneas
  project         Project        @relation(fields: [project_id], references: [project_id], onDelete: Restrict, onUpdate: Cascade)
  reviewer        User           @relation("ConflictReviewer", fields: [reviewer_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  resolver        User?          @relation("ConflictResolver", fields: [resolved_by], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([project_id, reviewer_id])
  @@index([status])
}

// ==========================================
// ARCHIVO INSTITUCIONAL (RF-020)
// Al pasar a Closed, el proyecto se congela
// en solo lectura y se conserva un snapshot
// inmutable de todo su expediente.
// ==========================================

model Project_Archive {
  archive_id    Int      @id @default(autoincrement())
  project_id    Int      @unique
  // Copia congelada del proyecto y sus relaciones (JSONB).
  snapshot      Json
  // SHA-256 del snapshot para detectar alteraciones posteriores.
  snapshot_hash String   @db.VarChar(64)
  archived_at   DateTime @default(now()) @db.Timestamp()

  project       Project  @relation(fields: [project_id], references: [project_id], onDelete: Restrict, onUpdate: Cascade)

  @@index([archived_at])
}

model Archive_Alert {
  alert_id      Int       @id @default(autoincrement())
  // null cuando falla el job completo (p. ej. BD no disponible).
  project_id    Int?
  attempted_at  DateTime  @default(now()) @db.Timestamp()
  error_message String    @db.Text
  resolved_at   DateTime? @db.Timestamp()

  project       Project?  @relation(fields: [project_id], references: [project_id], onDelete: Restrict, onUpdate: Cascade)

  @@index([project_id, attempted_at])
  @@index([resolved_at])
}

// ==========================================
// NOTIFICACIONES (RF-014)
// Bandeja in-app por usuario + cola
// persistente de correos con reintentos.
// ==========================================

enum NotificationType {
  Decision
  Milestone
  Evidence
  Archive
  Role
  Invitation
  Deadline
  System
  // F1-02 / F1-11: alertas de SLA de revision y retencion de datos.
  Retention
  Sla
}

enum EmailStatus {
  Pending
  Sent
  Failed
  Skipped
}

model Notification {
  notification_id Int              @id @default(autoincrement())
  user_id         String
  type            NotificationType
  title           String           @db.VarChar(200)
  message         String           @db.Text
  // Ruta interna del frontend para abrir el recurso relacionado.
  link            String?          @db.VarChar(500)
  read_at         DateTime?        @db.Timestamp()
  created_at      DateTime         @default(now()) @db.Timestamp()

  user            User             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  emails          Email_Outbox[]

  @@index([user_id, read_at, created_at])
  @@index([user_id, created_at])
}

model Email_Outbox {
  email_id        Int              @id @default(autoincrement())
  // La notificacion que origino el correo (null si se encola suelto).
  notification_id Int?
  recipient       String           @db.VarChar(320)
  subject         String           @db.VarChar(300)
  body            String           @db.Text
  status          EmailStatus      @default(Pending)
  attempts        Int              @default(0)
  next_attempt_at DateTime         @default(now()) @db.Timestamp()
  sent_at         DateTime?        @db.Timestamp()
  error           String?          @db.Text
  created_at      DateTime         @default(now()) @db.Timestamp()

  notification    Notification?    @relation(fields: [notification_id], references: [notification_id], onDelete: SetNull, onUpdate: Cascade)

  @@index([status, next_attempt_at])
  @@index([notification_id])
}