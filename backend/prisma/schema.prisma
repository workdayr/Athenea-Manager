generator client {
  provider        = "prisma-client"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
  // Dentro de src/ para que `nest build` (tsc, rootDir src) compile el
  // cliente generado dentro de dist/ y resuelva en runtime.
  output          = "../src/generated/prisma"
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// Modelo para RAG con soporte vectorial y control de acceso
model Document {
  id         String   @id @default(uuid())
  title      String
  content    String
  embedding  Unsupported("vector(1536)")? // Embeddings estándar (OpenAI/OpenRouter)
  roleAccess String[] @default([])        // Roles con acceso (ej. ['ADMIN', 'MANAGER'])
  createdAt  DateTime                     @default(now())
  updatedAt  DateTime                     @updatedAt
}

// Tablas de autenticacion (BetterAuth). La tabla "user" es la fuente de
// verdad de usuarios; la tabla legacy "Users" del diccionario de datos
// se elimino (migracion drop_users_legacy).

model User {
  id             String    @id
  name           String
  email          String
  emailVerified  Boolean   @default(false)
  image          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  // RF-001: rol de plataforma. Por defecto STUDENT; el administrador lo
  // reasigna despues. El cliente nunca puede fijarlo (input: false).
  role           Role      @default(STUDENT)
  // RF-010: contador de intentos fallidos y expiracion del bloqueo.
  // Internos: no se exponen en respuestas (returned: false).
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  sessions       Session[]
  accounts       Account[]
  projectUsers   Project_User[]
  // RF-019 / RF-017: vinculos de auditoria y evaluacion
  // (Audit_Log.actor_id, Proposal_Evaluation.reviewer_id y
  // Review_Conflict.reviewer_id/resolved_by apuntan a user.id).
  auditLogs         Audit_Log[]
  evaluations       Proposal_Evaluation[] @relation("EvaluationReviewer")
  conflictReviews   Review_Conflict[]     @relation("ConflictReviewer")
  resolvedConflicts Review_Conflict[]     @relation("ConflictResolver")

  @@unique([email])
  @@map("user")
}

/**
 * Roles de plataforma (diccionario de datos, seccion 4.1 del documento
 * de arquitectura). Los roles de proyecto (PI/Co-Investigador/Asistente)
 * se modelaran en Project_User en una tarea posterior.
 */
enum Role {
  STUDENT
  PRINCIPAL_INVESTIGATOR
  COORDINATOR
  COMMITTEE
  ADMINISTRATOR
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  // Identificador del emisor de la cuenta (requerido por BetterAuth 1.7:
  // "local:credential" para email+password). Sin esta columna el registro
  // falla con 500 al crear la fila `account`.
  issuer                String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum ProjectStatus {
  Proposed
  Under_Review
  Approved
  Active
  Completed
  Closed
  Rejected
  Suspended
}

enum ProjectRole {
  Principal_Investigator
  Co_Investigator
  Assistant
}

enum DocType {
  hypothesis
  abstract
  methodology
  rationale
  results
  ethics_approval
}

enum Visibility {
  Team_only
  Shared_with_administration
}

enum MilestoneStatus {
  Pending
  Completed
  Delayed
}

enum ProductType {
  journal_article
  conference_presentation
  software
  patent
  thesis
}

// ==========================================
// MODELOS (Tablas de la base de datos)
// ==========================================

model Announcement {
  call_id         Int       @id @default(autoincrement())
  title           String    @db.VarChar(200)
  date_published  DateTime? @db.Timestamp()
  deadline        DateTime  @db.Timestamp()
  description     String    @db.Text
  application_cap Int
  // US 2.2 / RF-018: estado de la convocatoria y contador de
  // postulaciones (el contador + SELECT ... FOR UPDATE serializan el cupo).
  status            CallStatus @default(DRAFT)
  application_count Int        @default(0)

  projects        Project[]
}

/**
 * US 2.2 / RF-018: ciclo de vida de una convocatoria.
 * DRAFT = creada por el admin, aun no visible. OPEN = recibe
 * postulaciones. CLOSED = cerrada por deadline, cupo o manualmente.
 */
enum CallStatus {
  DRAFT
  OPEN
  CLOSED
}

model Project {
  project_id      Int           @id @default(autoincrement())
  title           String        @db.VarChar(300)
  objectives      String        @db.Text
  start_date      DateTime      @db.Timestamp()
  end_date        DateTime      @db.Timestamp()
  status          ProjectStatus @default(Proposed)
  budget_enabled  Boolean       @default(false)
  is_confidential Boolean
  // Convocatoria de origen (US 2.1: registro en respuesta a una call).
  // Opcional para no bloquear registros fuera de convocatoria.
  call_id         Int?

  // Relaciones inversas
  call            Announcement?   @relation(fields: [call_id], references: [call_id])
  projectUsers    Project_User[]
  documents       ProjectDocument[] 
  milestones      Milestone[]
  products        Product[]
  expenses        Expense[]
  // RF-019: historial formal de decisiones y alertas de conflicto (BR-011).
  evaluations     Proposal_Evaluation[]
  conflicts       Review_Conflict[]
}

model Project_User {
  projectuser_id  Int         @id @default(autoincrement())
  project_id      Int
  // PI / miembro del equipo (FK a user.id de BetterAuth, texto).
  user_id         String
  project_role    ProjectRole

  // Llaves foráneas
  project         Project     @relation(fields: [project_id], references: [project_id])
  user            User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

// Nota: Se renombra a ProjectDocument para evitar conflicto con el modelo Document para RAG que ya tenías en tu archivo
model ProjectDocument {
  document_id     Int         @id @default(autoincrement())
  project_id      Int
  doc_type        DocType
  visibility      Visibility
  file_url        String
  version         Int
  // Metadatos del archivo fisico (RNF-005: control de cuota por proyecto).
  file_name       String?
  file_size       Int?
  uploaded_at     DateTime    @default(now()) @db.Timestamp()

  // Llaves foráneas
  project         Project     @relation(fields: [project_id], references: [project_id])
}

model Milestone {
  milestone_id    Int             @id @default(autoincrement())
  project_id      Int
  name            String          @db.VarChar(150)
  // Columna huerfana: la FK hacia Users se elimino con la tabla legacy.
  assignee_id     Int
  due_date        DateTime        @db.Date
  status          MilestoneStatus

  // Llaves foráneas
  project         Project         @relation(fields: [project_id], references: [project_id])
}

model Product {
  product_id      Int         @id @default(autoincrement())
  project_id      Int
  product_type    ProductType
  url_doi         String

  // Llaves foráneas
  project         Project     @relation(fields: [project_id], references: [project_id])
}

model Expense {
  expense_id          Int       @id @default(autoincrement())
  project_id          Int
  amount              Decimal   @db.Decimal(9, 2)
  expense_description String    @db.VarChar(255)

  // Llaves foráneas
  project             Project   @relation(fields: [project_id], references: [project_id])
}

model Audit_Log {
  log_id          Int       @id @default(autoincrement())
  // Actor de la accion auditada (RF-017): FK a user.id de BetterAuth.
  actor_id        String
  action          String    @db.VarChar(255)
  target_id       String    @db.VarChar(255)
  source_ip       String
  timestamp       DateTime  @default(now()) @db.Timestamp()

  // Llaves foráneas
  actor           User      @relation(fields: [actor_id], references: [id])
}

// ==========================================
// EVALUACION DE PROPUESTAS (RF-019, BR-011)
// Decisiones formales del comite y alertas de
// conflicto de interes familiar persistentes.
// ==========================================

enum EvaluationDecision {
  Approved
  Rejected
  Revision_Required
}

enum ConflictStatus {
  Pending
  Cleared
  Confirmed
}

model Proposal_Evaluation {
  evaluation_id Int                @id @default(autoincrement())
  project_id    Int
  reviewer_id   String
  decision      EvaluationDecision
  justification String             @db.Text
  created_at    DateTime           @default(now()) @db.Timestamp()

  // Llaves foráneas
  project       Project            @relation(fields: [project_id], references: [project_id], onDelete: Restrict, onUpdate: Cascade)
  reviewer      User               @relation("EvaluationReviewer", fields: [reviewer_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([project_id])
  @@index([reviewer_id])
}

model Review_Conflict {
  conflict_id     Int            @id @default(autoincrement())
  project_id      Int
  reviewer_id     String
  status          ConflictStatus @default(Pending)
  detected_at     DateTime       @default(now()) @db.Timestamp()
  resolved_at     DateTime?      @db.Timestamp()
  resolved_by     String?
  resolution_note String?        @db.Text

  // Llaves foráneas
  project         Project        @relation(fields: [project_id], references: [project_id], onDelete: Restrict, onUpdate: Cascade)
  reviewer        User           @relation("ConflictReviewer", fields: [reviewer_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  resolver        User?          @relation("ConflictResolver", fields: [resolved_by], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([project_id, reviewer_id])
  @@index([status])
}