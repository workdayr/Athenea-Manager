# Database. BD actual: Neon (pooler para runtime, con sslmode=require).
# Para `prisma migrate deploy` se prefiere la URL directa (mismo host SIN
# el sufijo `-pooler`); si el pooler falla por el modo transaccion de
# PgBouncer, pasarla temporalmente por env: DATABASE_URL=<directa>.
# Formato Neon:
# DATABASE_URL=postgresql://USUARIO:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Alternativa local (docker-compose, servicio `postgres`):
# DATABASE_URL=postgresql://research_admin:dev123@localhost:5432/research_platform
DATABASE_URL=

# BetterAuth (minimo 32 caracteres de alta entropia; generar con: openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Server
PORT=3001
FRONTEND_ORIGIN=http://localhost:3000
NODE_ENV=development

# OAuth Google Workspace (RF-015). Sin estas credenciales el proveedor
# Google no se registra y /sign-in/social responde PROVIDER_NOT_FOUND.
# Obtener en Google Cloud Console: OAuth client ID tipo Web con redirect
# URI http://localhost:3001/api/auth/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dominios externos autorizados ademas del institucional, separados por coma
# (RF-015). Vacio = solo @unipolidgo.edu.mx.
AUTHORIZED_EMAIL_DOMAINS=

# Antivirus ClamAV (RF-016, F-05). Host del servicio clamd (INSTREAM).
# En docker-compose es el nombre del servicio `clamav`; en desarrollo
# local sin Docker usar localhost:3310 (se debe levantar clamav aparte).
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
# Timeout del escaneo en milisegundos. Si excede, la subida se rechaza con
# 503 y nada se guarda (fail closed).
ANTIVIRUS_TIMEOUT_MS=30000

# Directorio donde se guardan los archivos subidos (RF-016). Default:
# <cwd>/uploads.
UPLOAD_DIR=

# RF-020: intervalo del job de archivado de proyectos cerrados, en ms.
# Vacio = 24 horas. Util para probar el archivado automatico en desarrollo
# (p. ej. 60000 para ejecutarlo cada minuto).
PROJECT_ARCHIVE_INTERVAL_MS=

# F1-02: SLA de revision. Un proyecto Under_Review con mas de
# PROJECT_SLA_REVIEW_DAYS dias avisa una sola vez a los administradores.
# PROJECT_SLA_INTERVAL_MS vacio = barrido diario (util para probar: 60000).
PROJECT_SLA_REVIEW_DAYS=30
PROJECT_SLA_INTERVAL_MS=

# F1-11 / BR-013: retencion de proyectos con seres humanos. El aviso se
# envia PROJECT_RETENTION_NOTICE_DAYS antes del borrado seguro y el job
# corre cada PROJECT_RETENTION_INTERVAL_MS (vacio = diario).
PROJECT_RETENTION_YEARS=5
PROJECT_RETENTION_NOTICE_DAYS=30
PROJECT_RETENTION_INTERVAL_MS=

# F2-07 / BR-008: hitos. Un hito Pending sin avance durante
# MILESTONE_DELAY_DAYS pasa a Delayed y se avisa al responsable y al PI.
# MILESTONE_SCAN_INTERVAL_MS vacio = barrido diario (util probar: 60000).
MILESTONE_DELAY_DAYS=7
MILESTONE_SCAN_INTERVAL_MS=

# RF-014: correo saliente via SMTP (Nodemailer). Sin SMTP_HOST el sistema
# funciona en modo fail-soft: las notificaciones in-app se guardan y los
# correos de la outbox quedan marcados como `Skipped` (no se envian).
# En docker-compose el host es el servicio `mailpit` (UI en :8025).
SMTP_HOST=
SMTP_PORT=1025
# true para TLS implicito (puerto 465). Mailpit y la mayoria de relays
# locales usan STARTTLS/plano en 1025, por lo que el default es false.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Athenea Manager <no-reply@athenea.local>

# F1-06 / RF-010: verificacion de correo.
# EMAIL_VERIFICATION_REQUIRED=true exige el correo verificado para iniciar
# sesion. Vacio = solo en produccion; en desarrollo queda desactivado para
# no bloquear cuentas existentes. El enlace de recuperacion expira en 30 min.
EMAIL_VERIFICATION_REQUIRED=

# RF-014: job que vacia la cola persistente de correos.
# EMAIL_OUTBOX_INTERVAL_MS: frecuencia de barrido (default 30000).
# EMAIL_OUTBOX_MAX_ATTEMPTS: intentos antes de marcar `Failed` (default 5).
EMAIL_OUTBOX_INTERVAL_MS=30000
EMAIL_OUTBOX_MAX_ATTEMPTS=5

# F1-10 / RF-019: dictamenes en PDF asincronos. El job revisa los reportes
# pendientes cada DECISION_REPORT_INTERVAL_MS (vacio = 15000) y agota hasta
# DECISION_REPORT_MAX_ATTEMPTS intentos antes de marcarlos `Failed` (default 3).
DECISION_REPORT_INTERVAL_MS=
DECISION_REPORT_MAX_ATTEMPTS=3

# F1-08 / RNF-001: cifrado en reposo (AES-256-GCM). Clave de 32 bytes
# en hex (64 caracteres) o base64 (44). Sin ella el servicio de cifrado
# no esta disponible (fail-closed). Generar con: openssl rand -hex 32
DATA_ENCRYPTION_KEY=
