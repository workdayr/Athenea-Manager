# Database. BD actual: Neon (pooler para runtime, con sslmode=require).
# Para `prisma migrate deploy` se prefiere la URL directa (mismo host SIN
# el sufijo `-pooler`); si el pooler falla por el modo transaccion de
# PgBouncer, pasarla temporalmente por env: DATABASE_URL=<directa>.
# Formato Neon:
# DATABASE_URL=postgresql://USUARIO:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Alternativa local (docker-compose, servicio `postgres`):
# DATABASE_URL=postgresql://research_admin:dev123@localhost:5432/research_platform
DATABASE_URL=

# BetterAuth (minimo 32 caracteres de alta entropia; generar con: openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Server
PORT=3001
FRONTEND_ORIGIN=http://localhost:3000
NODE_ENV=development

# OAuth Google Workspace (RF-015). Sin estas credenciales el proveedor
# Google no se registra y /sign-in/social responde PROVIDER_NOT_FOUND.
# Obtener en Google Cloud Console: OAuth client ID tipo Web con redirect
# URI http://localhost:3001/api/auth/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dominios externos autorizados ademas del institucional, separados por coma
# (RF-015). Vacio = solo @unipolidgo.edu.mx.
AUTHORIZED_EMAIL_DOMAINS=
